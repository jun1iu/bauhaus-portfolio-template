# Copy to .env and edit. The server reads it when you run "npm run server".

# Port and address to listen on. 127.0.0.1 keeps it private to this computer; use 0.0.0.0 to accept outside connections.
PORT=3001
HOST=127.0.0.1

# Where the database and uploaded photos are kept (created automatically, and ignored by git).
DATA_DIR=data

# The built public site to serve (run "npm run build" first).
PUBLIC_DIR=dist

# Admin password for the FIRST run only. Leave blank and the server invents one and prints it once.
# After that, change it in the admin under Account.
ADMIN_PASSWORD=

# Set both to 1 when the site is served over HTTPS behind a proxy such as nginx or Caddy.
COOKIE_SECURE=0
TRUST_PROXY=0

# Other sites allowed to read the content and send contact messages to this server,
# separated by commas. Needed if your public site stays on GitHub Pages, for example:
# CORS_ORIGINS=https://your-name.github.io
CORS_ORIGINS=
